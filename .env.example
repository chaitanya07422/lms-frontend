# Public API base including /api/v1 prefix (browser-visible)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# App
NEXT_PUBLIC_APP_NAME=CreditSea

# Optional — PostHog analytics (leave empty to disable)
# Project API key from PostHog → Project settings
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# Use /ingest locally/prod (Next.js rewrite proxy). Or set a direct host:
# NEXT_PUBLIC_POSTHOG_HOST=/ingest
# NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
